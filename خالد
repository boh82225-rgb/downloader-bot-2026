
# بوت التحميل - النسخة المصححة للبوت الأول - 24/7
# يحمل من تيك توك / انستا / يوتيوب / فيسبوك / تويتر
# طريقة التشغيل: حط التوكن في Secrets باسم BOT_TOKEN
# pip install python-telegram-bot yt-dlp requests

import os, logging, glob, requests
import yt_dlp
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, ContextTypes, filters

TOKEN = os.getenv("BOT_TOKEN", "")
logging.basicConfig(level=logging.INFO)

def expand_short_link(url):
    """يفك الروابط المختصرة مثل vt.tiktok.com"""
    try:
        r = requests.head(url, allow_redirects=True, timeout=10)
        return r.url
    except:
        try:
            r = requests.get(url, allow_redirects=True, timeout=10)
            return r.url
        except:
            return url

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "أهلاً فيك 👋\nأنا بوت التحميل الجديد.\nأرسل لي أي رابط من تيك توك / انستا / يوتيوب / فيسبوك وأنا أحمله لك بدون علامة مائية."
    )

async def help_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("أرسل أي رابط فيديو وأنا أرسله لك.\n/start - البداية")

async def download(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    if "http" not in text:
        await update.message.reply_text("أرسل لي رابط فيديو صحيح.")
        return

    # 1. فك الرابط المختصر - هذا كان سبب الخطأ الأول
    real_url = expand_short_link(text)

    msg = await update.message.reply_text("جاري التحميل... ⏳")

    # 3 طرق للتحميل، إذا فشلت الأولى يجرب الثانية
    attempts = [
        {'format': 'best[ext=mp4]/best', 'outtmpl': '/tmp/%(id)s.%(ext)s', 'noplaylist': True, 'quiet': True, 'no_warnings': True, 'max_filesize': 50*1024*1024},
        {'format': 'mp4/best', 'outtmpl': '/tmp/%(id)s.%(ext)s', 'noplaylist': True, 'quiet': True, 'no_warnings': True, 'max_filesize': 50*1024*1024},
        {'format': 'worstvideo+worstaudio/worst', 'outtmpl': '/tmp/%(id)s.%(ext)s', 'noplaylist': True, 'quiet': True, 'no_warnings': True, 'max_filesize': 50*1024*1024},
    ]

    success = False
    last_error = ""
    for opts in attempts:
        try:
            with yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(real_url, download=True)
                filename = ydl.prepare_filename(info)
                if not os.path.exists(filename):
                    files = glob.glob(f"/tmp/{info.get('id')}.*")
                    if not files:
                        continue
                    filename = files[0]

            await update.message.reply_video(video=open(filename, 'rb'), caption="تم التحميل ✅ @DI_Downloader2026_bot")
            await msg.delete()
            try: os.remove(filename)
            except: pass
            success = True
            break
        except Exception as e:
            last_error = str(e)
            logging.error(f"Attempt failed: {e}")
            continue

    if not success:
        await msg.edit_text("ما قدرت أحمل هذا الفيديو.\nجرب رابط ثاني، وتأكد إن الفيديو عام ومو خاص.\nإذا تكررت المشكلة أرسل لي الرابط الكامل من زر المشاركة في تيك توك، مو الرابط المختصر.")

def main():
    if not TOKEN:
        print("ERROR: ضع BOT_TOKEN في Secrets")
        return
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_cmd))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, download))
    print("Bot is running 24/7 - Fixed Version")
    app.run_polling()

if __name__ == "__main__":
    main()
